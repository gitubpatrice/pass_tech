<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages this app ships, so that Android 13 and above offer it under
  Settings › Apps › Pass Tech › Language — a language for this app alone, without
  changing the phone's.

  The same five appear in `androidResources.localeFilters` of `app/build.gradle.kts`,
  which is what decides whether their `values-*` survive the build at all, as
  `values-fr`, `values-de`, `values-it`, `values-es` beside `values`, and in
  `AppLanguage.CODES`, which is what the app's own picker offers below Android 13.
  A language missing from any one of those four places is a language nobody can
  reach; `StringsParityTest` holds the four to the same set.

  Below Android 13 there is no system setting for this, and the app carries its own
  picker under Settings › Language — as 2.7.1 did, for every phone that far back.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fr" />
    <locale android:name="de" />
    <locale android:name="it" />
    <locale android:name="es" />
</locale-config>
