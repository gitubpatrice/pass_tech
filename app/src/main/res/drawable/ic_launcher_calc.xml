<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon of the panic disguise (2.7.1, SEC F2 v2.5.4).

  A drawing of its own, never @mipmap/ic_launcher: the disguised alias used to reuse the app icon,
  so the Pass Tech logo stayed on the launcher under the name "Calculator" — more telling than no
  disguise at all.

  A vector rather than one PNG per density: sharp at every size, one file, and no adaptive mask
  applied by the launcher, so it shows as it is, without being cut into a circle.

  Plain grey on purpose. A generic system calculator draws no attention; any brand colour would
  work against the point.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The body, rounded corners. -->
    <path
        android:fillColor="#546E7A"
        android:pathData="M26,10h56a8,8 0,0 1,8 8v72a8,8 0,0 1,-8 8h-56a8,8 0,0 1,-8 -8v-72a8,8 0,0 1,8 -8z" />

    <!-- The display. -->
    <path
        android:fillColor="#CFD8DC"
        android:pathData="M28,20h52v18h-52z" />

    <!-- The keys: four rows of three. -->
    <path
        android:fillColor="#ECEFF1"
        android:pathData="M28,46h12v10h-12z M48,46h12v10h-12z M68,46h12v10h-12z
                          M28,62h12v10h-12z M48,62h12v10h-12z M68,62h12v10h-12z
                          M28,78h12v10h-12z M48,78h12v10h-12z" />

    <!-- The "=" key, warm, as on a real calculator. -->
    <path
        android:fillColor="#FF8A65"
        android:pathData="M68,78h12v10h-12z" />
</vector>
