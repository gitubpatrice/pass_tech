    <!-- Anti-phishing -->
    <string name="phishing_service_label">Pass Tech — anti-phishing</string>
    <string name="phishing_detector_description">Lit le domaine affiché par le navigateur au premier plan, pour vérifier qu\'il correspond à l\'entrée Pass Tech avant de copier un mot de passe. Seul le domaine est lu, uniquement en mémoire : rien n\'est enregistré, rien n\'est envoyé. Seuls les navigateurs reconnus sont lus. Cette lecture est activée à votre demande, et disparaît de cette liste dès que vous la désactivez dans Pass Tech.</string>

    <string name="settings_section_anti_phishing">Anti-phishing</string>
    <string name="settings_anti_phishing_title">Vérifier le domaine avant de copier</string>
    <string name="settings_anti_phishing_description">Compare le domaine du navigateur à celui de l\'entrée</string>
    <string name="settings_anti_phishing_active">Activé — prévient si le navigateur n\'est pas sur le bon domaine</string>
    <string name="settings_anti_phishing_needs_grant">⚠ Activez « %1$s » dans Accessibilité</string>
    <string name="settings_anti_phishing_open_title">Ouvrir Réglages &gt; Accessibilité</string>
    <string name="settings_anti_phishing_open_subtitle">Activez « %1$s » dans la liste</string>
    <string name="settings_anti_phishing_dialog_title">Anti-phishing</string>
    <string name="settings_anti_phishing_dialog_body">Pass Tech peut vérifier que le navigateur au premier plan est bien sur le domaine de l\'entrée AVANT de copier votre mot de passe, et vous prévenir quand ce n\'est pas le cas — nom qui ressemble, faux site.\n\nPour cela l\'app utilise un service d\'accessibilité Android :\n• il lit le domaine de la barre d\'adresse, et rien d\'autre\n• uniquement sur les navigateurs reconnus (Chrome, Firefox, Brave, Edge, Opera, Vivaldi, Samsung, DuckDuckGo)\n• rien n\'est enregistré, rien n\'est envoyé\n\nDésactiver ici reprend l\'autorisation : le service quitte la liste d\'accessibilité d\'Android, et le réactiver vous la redemandera.\n\nSur l\'écran suivant, activez « %1$s ».</string>
    <string name="settings_anti_phishing_on_failed">Android a refusé d\'ajouter le service</string>
    <string name="settings_anti_phishing_off_failed">Android a refusé de retirer le service — retirez-le à la main dans Réglages &gt; Accessibilité</string>

    <string name="phishing_unchecked_snack">⚠ Domaine non vérifié — le service anti-phishing ne tourne pas</string>
