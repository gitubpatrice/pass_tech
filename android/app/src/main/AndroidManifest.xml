<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- v2.5.0 (F12) : USE_FINGERPRINT retirée de CE fichier. Obsolète depuis
         API 28 (Android 9), USE_BIOMETRIC la remplace et couvre l'ensemble des
         modalités (empreinte, visage, iris).

         ⚠️ AUDIT 2026-08-03 — le commentaire d'origine était doublement faux,
         et il faut le dire pour que personne ne re-tente le « nettoyage » :

           1. Il affirmait « minSdk = 26 ». C'est 24 (cf. build.gradle.kts,
              abaissé pour pouvoir couper enableV1Signing / Janus). Le parc
              API 24-27 est donc DANS la cible, et sur ces versions
              androidx.biometric retombe sur FingerprintManager, qui EXIGE
              USE_FINGERPRINT. La retirer pour de bon casserait la biométrie
              sur Android 7.0 → 8.1.

           2. Le bénéfice annoncé (« une permission de moins dans la liste vue
              par le user/store ») n'a JAMAIS existé : le plugin
              biometric_storage la déclare lui-même, sans maxSdkVersion, et
              elle réapparaît donc dans le manifeste FUSIONNÉ de la release.
              Vérifiable :
                grep USE_FINGERPRINT build/app/intermediates/merged_manifest/\
                  release/processReleaseMainManifest/AndroidManifest.xml

         Conclusion : on la laisse hors de ce fichier (elle arrive par le
         plugin de toute façon) et on ne tente PAS de la supprimer via
         tools:node="remove" — ce serait une régression fonctionnelle réelle
         pour un bénéfice cosmétique inexistant. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- AUDIT 2026-08-03 — ACCESS_NETWORK_STATE n'est PAS déclarée ici mais
         arrive dans l'APK final via com.google.android.datatransport:
         transport-backend-cct, tiré par mobile_scanner → ML Kit → Play
         Services. Elle est documentée comme telle dans PRIVACY.md §6 plutôt
         que redéclarée ici : la redéclarer masquerait son origine réelle.
         Voir aussi THIRD_PARTY_NOTICES.md (dépendances transitives Google). -->

    <application
        android:label="Pass Tech"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <!-- L'activity n'a PAS de LAUNCHER : on passe par 2 alias activables/
             désactivables au runtime pour le mode panique + camouflage. -->
        <!-- AUDIT 2026-08-03 — `exported` passe à false. Ce n'est PAS une
             restriction fonctionnelle : les deux points d'entrée légitimes
             restent ouverts.
               • Le lanceur passe par les activity-alias ci-dessous, qui portent
                 le filtre MAIN/LAUNCHER et leur propre `exported="true"` —
                 c'est l'alias qui est résolu par le système, la cible n'a pas
                 besoin d'être exportée.
               • CalculatorActivity.revealPassTech() utilise un intent EXPLICITE
                 dans le même UID, sur lequel `exported` n'a aucune prise.
             Avant, n'importe quelle application installée pouvait démarrer
             l'écran de déverrouillage par ComponentName. Aucun extra n'y est
             traité, donc l'impact était faible — mais la surface était gratuite,
             et l'incohérence avec CalculatorActivity (déjà `exported="false"`)
             invitait à la recopier. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
        </activity>

        <!-- Alias normal : icône + label "Pass Tech". Activé par défaut. -->
        <activity-alias
            android:name=".MainAliasNormal"
            android:targetActivity=".MainActivity"
            android:label="Pass Tech"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Alias camouflage « Calculatrice ». Désactivé par défaut ; le mode
             panique l'active et désactive l'alias normal.

             SEC F2 v2.5.4 — camouflage RÉEL. Deux changements par rapport à la
             version précédente, où seul le LIBELLÉ changeait :

               1. `android:icon` pointe sur un jeu d'icônes DISTINCT
                  (@drawable/ic_launcher_calc). Avant, l'alias réutilisait
                  @mipmap/ic_launcher : le logo Pass Tech restait visible sur le
                  lanceur sous le nom « Calculatrice », incohérence plus
                  suspecte que l'absence de camouflage.
               2. `android:targetActivity` vise CalculatorActivity et non
                  MainActivity. Avant, toucher l'entrée ouvrait l'écran de
                  déverrouillage Pass Tech : le camouflage se démentait au
                  premier appui.

             La calculatrice est fonctionnelle — une façade inerte serait tout
             aussi révélatrice. Sortie de secours : appui long de 2 s sur
             l'affichage. Voir CalculatorActivity pour le raisonnement complet
             et les limites assumées. -->
        <activity
            android:name=".CalculatorActivity"
            android:label="Calculatrice"
            android:icon="@drawable/ic_launcher_calc"
            android:exported="false"
            android:theme="@style/NormalTheme" />

        <activity-alias
            android:name=".MainAliasDecoy"
            android:targetActivity=".CalculatorActivity"
            android:label="Calculatrice"
            android:icon="@drawable/ic_launcher_calc"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- AccessibilityService anti-phishing : détecte le domaine actif
             dans le navigateur pour vérifier la cohérence avec l'entrée
             Pass Tech avant copie. Désactivé par défaut, activable depuis
             Réglages > Anti-phishing. Permission BIND_ACCESSIBILITY_SERVICE
             réservée au système (l'utilisateur active manuellement). -->
        <service
            android:name=".PhishingDetectorService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="Pass Tech — anti-phishing">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phishing_detector_config" />
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher Android 11+ : sans ces queries, canLaunchUrl
             retourne false sur https/mailto (lien Apache, contact email…). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
