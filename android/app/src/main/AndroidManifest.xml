<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- v2.5.0 (F12) : USE_FINGERPRINT retiré. Obsolète depuis API 28
         (Android 9, septembre 2018). USE_BIOMETRIC le remplace et couvre
         l'ensemble des modalités biométriques (empreinte, visage, iris).
         Garder USE_FINGERPRINT = signal inutile + permission de plus dans
         la liste vue par le user/store. minSdk = 26 sur Pass Tech (cf.
         android/app/build.gradle.kts), donc l'écart API 26→28 ne touche
         pratiquement aucun device en circulation en 2026. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="Pass Tech"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <!-- L'activity n'a PAS de LAUNCHER : on passe par 2 alias activables/
             désactivables au runtime pour le mode panique + camouflage. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
        </activity>

        <!-- Alias normal : icône + label "Pass Tech". Activé par défaut. -->
        <activity-alias
            android:name=".MainAliasNormal"
            android:targetActivity=".MainActivity"
            android:label="Pass Tech"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Alias camouflage « Calculatrice ». Désactivé par défaut ; le mode
             panique l'active et désactive l'alias normal.

             SEC F2 v2.5.4 — camouflage RÉEL. Deux changements par rapport à la
             version précédente, où seul le LIBELLÉ changeait :

               1. `android:icon` pointe sur un jeu d'icônes DISTINCT
                  (@drawable/ic_launcher_calc). Avant, l'alias réutilisait
                  @mipmap/ic_launcher : le logo Pass Tech restait visible sur le
                  lanceur sous le nom « Calculatrice », incohérence plus
                  suspecte que l'absence de camouflage.
               2. `android:targetActivity` vise CalculatorActivity et non
                  MainActivity. Avant, toucher l'entrée ouvrait l'écran de
                  déverrouillage Pass Tech : le camouflage se démentait au
                  premier appui.

             La calculatrice est fonctionnelle — une façade inerte serait tout
             aussi révélatrice. Sortie de secours : appui long de 2 s sur
             l'affichage. Voir CalculatorActivity pour le raisonnement complet
             et les limites assumées. -->
        <activity
            android:name=".CalculatorActivity"
            android:label="Calculatrice"
            android:icon="@drawable/ic_launcher_calc"
            android:exported="false"
            android:theme="@style/NormalTheme" />

        <activity-alias
            android:name=".MainAliasDecoy"
            android:targetActivity=".CalculatorActivity"
            android:label="Calculatrice"
            android:icon="@drawable/ic_launcher_calc"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- AccessibilityService anti-phishing : détecte le domaine actif
             dans le navigateur pour vérifier la cohérence avec l'entrée
             Pass Tech avant copie. Désactivé par défaut, activable depuis
             Réglages > Anti-phishing. Permission BIND_ACCESSIBILITY_SERVICE
             réservée au système (l'utilisateur active manuellement). -->
        <service
            android:name=".PhishingDetectorService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="Pass Tech — anti-phishing">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phishing_detector_config" />
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher Android 11+ : sans ces queries, canLaunchUrl
             retourne false sur https/mailto (lien Apache, contact email…). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
