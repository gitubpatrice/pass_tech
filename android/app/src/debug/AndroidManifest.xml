<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 2026-09-21 — un build de test porte « (debug) » dans le lanceur.
         Appris sur appareil le jour même : les deux paquets cohabitaient sous
         le MÊME nom et la MÊME icône, et Patrice a désinstallé les deux faute
         de pouvoir les distinguer, emportant la release publiée avec.
         Le suffixe d'applicationId sépare les données ; ce libellé sépare ce
         que l'œil voit. Même convention que SMS Tech et Agenda Tech.

         La surcouche ne touche PAS le manifeste principal : la release garde
         son libellé exact, et les alias du mode panique restent intacts. Seul
         l'alias normal est renommé — l'alias de camouflage doit continuer de
         s'appeler « Calculatrice », y compris en débogage, sans quoi on ne
         pourrait pas tester le camouflage. -->
    <application tools:ignore="MissingApplicationIcon">
        <activity-alias
            android:name=".MainAliasNormal"
            android:targetActivity=".MainActivity"
            android:label="Pass Tech (debug)"
            tools:replace="android:label" />
    </application>
</manifest>
